[Unit]
Description=Syntra Supply & CRM Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/syntra/crm
ExecStart=/usr/bin/python3 /var/www/syntra/crm/server.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=ADMIN_PIN=2026
Environment=STAFF_PIN=1234
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
